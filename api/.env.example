# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Absolute path recommended in production. Relative paths resolve under api/.
SQLITE_PATH=data/maple.sqlite

# Public URLs. Defaults: https://api.maple.music and https://play.maple.music in production,
# http://localhost:PORT and http://localhost:5173 with --dev.
# API_URL=https://api.maple.music
# FRONTEND_URL=https://play.maple.music
TRUSTED_PROXIES=
# Replaces the default origin list when set.
# CORS_ORIGINS=https://api.maple.music,https://play.maple.music,https://beta.maple.music,https://discord.com,https://canary.discord.com,https://ptb.discord.com
# PASSKEY_RP_ID=maple.music
# PASSKEY_ORIGINS=https://play.maple.music,https://beta.maple.music

# Required in production for verification and password reset emails.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Maple <noreply@mail.maple.music>

# Used only by npm run db:migrate:mysql. Use an account with SELECT-only access.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maple_auth
MYSQL_USER=maple_export
MYSQL_PASSWORD=
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
# MYSQL_SSL_CA=/absolute/path/to/mysql-ca.pem
