# Keep the existing TOKEN_SECRET during cutover to preserve login cookies.
TOKEN_SECRET=replace-with-your-existing-secret

# Absolute path recommended in production. Relative paths resolve under api/.
SQLITE_PATH=data/maple.sqlite

# Used only by npm run db:migrate:mysql. Use an account with SELECT-only access.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=maple_auth
MYSQL_USER=maple_export
MYSQL_PASSWORD=
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
# MYSQL_SSL_CA=/absolute/path/to/mysql-ca.pem
